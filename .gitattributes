# Scripts run on Linux (also inside containers): never convert them to CRLF.
*.sh text eol=lf
tools/dev/Dockerfile text eol=lf
*.py text eol=lf
# LegacyRecomp patches to XenonRecomp: exact bytes (LF, as `git format-patch` wrote them), never converted.
thirdparty/patches/** -text
# stb single headers (pinned upstream bytes, ADR 0002): never converted.
thirdparty/stb/** -text
