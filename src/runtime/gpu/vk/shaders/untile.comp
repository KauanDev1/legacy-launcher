// PLACEHOLDER for the texture untile pass (Task 19). Today it is a linear word copy with the Xenos endian swap
// (the swap modes are the GPU_ENDIAN values of the fetch constant: 0 none, 1 8in16, 2 8in32, 3 16in32). The
// macro/micro-tile address arithmetic of the tiled layouts is added by Task 19, from the hardware layout, into this
// same interface.
#version 450

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) readonly buffer Source { uint words[]; } u_src;
layout(set = 0, binding = 1, std430) writeonly buffer Destination { uint words[]; } u_dst;
layout(push_constant) uniform Params {
  uint word_count;
  uint endian;
} u_params;

uint swap_endian(uint v, uint mode) {
  if (mode == 1u) return ((v & 0x00FF00FFu) << 8) | ((v >> 8) & 0x00FF00FFu);
  if (mode == 2u) return (v << 24) | ((v & 0xFF00u) << 8) | ((v >> 8) & 0xFF00u) | (v >> 24);
  if (mode == 3u) return (v << 16) | (v >> 16);
  return v;
}

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= u_params.word_count) return;
  u_dst.words[i] = swap_endian(u_src.words[i], u_params.endian);
}
