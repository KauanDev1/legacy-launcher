# SPDX-License-Identifier: MIT
# cmake -P script: turns SPIR-V files into gpu_shaders.h / gpu_shaders.cpp (see LrGpuShaders.cmake).
# Inputs: OUT_DIR, SPVS and NAMES (lists separated by "|"). SPIR-V words are little-endian on every supported host.
string(REPLACE "|" ";" spv_list "${SPVS}")
string(REPLACE "|" ";" name_list "${NAMES}")

set(decls "")
set(defs "")
set(table "")
list(LENGTH spv_list count)
math(EXPR last "${count} - 1")
foreach(i RANGE ${last})
  list(GET spv_list ${i} spv)
  list(GET name_list ${i} name)
  string(MAKE_C_IDENTIFIER "${name}" id)
  file(READ "${spv}" hex HEX)
  string(LENGTH "${hex}" hex_len)
  math(EXPR rem "${hex_len} % 8")
  if(NOT rem EQUAL 0 OR hex_len EQUAL 0)
    message(FATAL_ERROR "${spv} is not a whole number of 32-bit SPIR-V words")
  endif()
  math(EXPR words "${hex_len} / 8")
  string(REGEX MATCHALL "[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]" chunks "${hex}")
  set(body "")
  set(col 0)
  foreach(c IN LISTS chunks)
    string(SUBSTRING "${c}" 0 2 b0)
    string(SUBSTRING "${c}" 2 2 b1)
    string(SUBSTRING "${c}" 4 2 b2)
    string(SUBSTRING "${c}" 6 2 b3)
    string(APPEND body "0x${b3}${b2}${b1}${b0}u,")
    math(EXPR col "${col} + 1")
    if(col EQUAL 8)
      string(APPEND body "\n    ")
      set(col 0)
    endif()
  endforeach()
  string(APPEND decls "extern const std::uint32_t ${id}[${words}];\n")
  string(APPEND defs "alignas(4) const std::uint32_t ${id}[${words}] = {\n    ${body}\n};\n\n")
  string(APPEND table "    {\"${name}\", ${id}, ${words}},\n")
endforeach()

file(WRITE "${OUT_DIR}/gpu_shaders.h" "// Generated by cmake/LrSpvEmbed.cmake from src/runtime/gpu/vk/shaders; do not edit, never commit.
// SPDX-License-Identifier: MIT
#pragma once

#include <cstddef>
#include <cstdint>

namespace lr::gpu::vk::shaders {

struct BuiltinShader {
  const char* name;  // the GLSL file name, e.g. \"blit.frag\"
  const std::uint32_t* words;
  std::size_t word_count;
};

${decls}
extern const BuiltinShader kBuiltinShaders[${count}];
inline constexpr std::size_t kBuiltinShaderCount = ${count};

}  // namespace lr::gpu::vk::shaders
")
file(WRITE "${OUT_DIR}/gpu_shaders.cpp" "// Generated by cmake/LrSpvEmbed.cmake; do not edit, never commit.
// SPDX-License-Identifier: MIT
#include \"gpu_shaders.h\"

namespace lr::gpu::vk::shaders {

${defs}const BuiltinShader kBuiltinShaders[${count}] = {
${table}};

}  // namespace lr::gpu::vk::shaders
")
