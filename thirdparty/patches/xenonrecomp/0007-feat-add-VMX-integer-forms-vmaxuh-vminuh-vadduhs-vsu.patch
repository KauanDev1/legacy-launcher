From 6ffcffee1962cac8f3c23e5919719cb2862039d1 Mon Sep 17 00:00:00 2001
From: Kauan Turcato Storto <159664484+KauanDev1@users.noreply.github.com>
Date: Sun, 18 Oct 2026 19:55:13 -0400
Subject: [PATCH 07/10] feat: add VMX integer forms vmaxuh, vminuh, vadduhs,
 vsubuws, vavguw, vslh, vrlw, vnor, vcmpequh, vcmpgtuw

vmaxuh/vminuh/vadduhs map to the unsigned 16-bit SSE operations;
vsubuws, vavguw, vslh and vrlw/vrlw128 are lane-wise scalar code that
reads a lane's sources before writing it. vnor/vnor128 is ~(vA | vB),
also when vA == vB (vnot). vcmpequh and vcmpgtuw (unsigned, via flipped
sign bits) set cr6 in their Rc forms like the other vector compares.

vcmpequh follows hedge-dev/XenonRecomp PR #60 by Mystixor (MIT).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 XenonRecomp/recompiler.cpp | 52 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 52 insertions(+)

diff --git a/XenonRecomp/recompiler.cpp b/XenonRecomp/recompiler.cpp
index e5ed787..bbe9e44 100644
--- a/XenonRecomp/recompiler.cpp
+++ b/XenonRecomp/recompiler.cpp
@@ -2060,6 +2060,19 @@ bool Recompiler::Recompile(
         println("\tsimde_mm_store_si128((simde__m128i*){}.u8, simde_mm_cmpgt_epu16(simde_mm_load_si128((simde__m128i*){}.u16), simde_mm_load_si128((simde__m128i*){}.u16)));", v(insn.operands[0]), v(insn.operands[1]), v(insn.operands[2]));
         break;
 
+    case PPC_INST_VCMPEQUH:
+        println("\tsimde_mm_store_si128((simde__m128i*){}.u16, simde_mm_cmpeq_epi16(simde_mm_load_si128((simde__m128i*){}.u16), simde_mm_load_si128((simde__m128i*){}.u16)));", v(insn.operands[0]), v(insn.operands[1]), v(insn.operands[2]));
+        if (strchr(insn.opcode->name, '.'))
+            println("\t{}.setFromMask(simde_mm_load_si128((simde__m128i*){}.u8), 0xFFFF);", cr(6), v(insn.operands[0]));
+        break;
+
+    case PPC_INST_VCMPGTUW:
+        // Unsigned compare: flip the sign bits, then compare signed.
+        println("\tsimde_mm_store_si128((simde__m128i*){}.u32, simde_mm_cmpgt_epi32(simde_mm_xor_si128(simde_mm_load_si128((simde__m128i*){}.u32), simde_mm_set1_epi32(int(0x80000000))), simde_mm_xor_si128(simde_mm_load_si128((simde__m128i*){}.u32), simde_mm_set1_epi32(int(0x80000000)))));", v(insn.operands[0]), v(insn.operands[1]), v(insn.operands[2]));
+        if (strchr(insn.opcode->name, '.'))
+            println("\t{}.setFromMask(simde_mm_load_si128((simde__m128i*){}.u8), 0xFFFF);", cr(6), v(insn.operands[0]));
+        break;
+
     case PPC_INST_VEXPTEFP:
     case PPC_INST_VEXPTEFP128:
         // TODO: vectorize
@@ -2093,6 +2106,45 @@ bool Recompiler::Recompile(
         println("\tsimde_mm_store_si128((simde__m128i*){}.u32, simde_mm_max_epi32(simde_mm_load_si128((simde__m128i*){}.u32), simde_mm_load_si128((simde__m128i*){}.u32)));", v(insn.operands[0]), v(insn.operands[1]), v(insn.operands[2]));
         break;
 
+    case PPC_INST_VMAXUH:
+        println("\tsimde_mm_store_si128((simde__m128i*){}.u16, simde_mm_max_epu16(simde_mm_load_si128((simde__m128i*){}.u16), simde_mm_load_si128((simde__m128i*){}.u16)));", v(insn.operands[0]), v(insn.operands[1]), v(insn.operands[2]));
+        break;
+
+    case PPC_INST_VMINUH:
+        println("\tsimde_mm_store_si128((simde__m128i*){}.u16, simde_mm_min_epu16(simde_mm_load_si128((simde__m128i*){}.u16), simde_mm_load_si128((simde__m128i*){}.u16)));", v(insn.operands[0]), v(insn.operands[1]), v(insn.operands[2]));
+        break;
+
+    case PPC_INST_VADDUHS:
+        println("\tsimde_mm_store_si128((simde__m128i*){}.u16, simde_mm_adds_epu16(simde_mm_load_si128((simde__m128i*){}.u16), simde_mm_load_si128((simde__m128i*){}.u16)));", v(insn.operands[0]), v(insn.operands[1]), v(insn.operands[2]));
+        break;
+
+    // Lane-wise scalar forms below read both sources of a lane before writing it, so vD may alias vA or vB.
+    case PPC_INST_VSUBUWS:
+        for (size_t i = 0; i < 4; i++)
+            println("\t{0}.u32[{1}] = {2}.u32[{1}] > {3}.u32[{1}] ? {2}.u32[{1}] - {3}.u32[{1}] : 0;", v(insn.operands[0]), i, v(insn.operands[1]), v(insn.operands[2]));
+        break;
+
+    case PPC_INST_VAVGUW:
+        for (size_t i = 0; i < 4; i++)
+            println("\t{0}.u32[{1}] = uint32_t((uint64_t({2}.u32[{1}]) + {3}.u32[{1}] + 1) >> 1);", v(insn.operands[0]), i, v(insn.operands[1]), v(insn.operands[2]));
+        break;
+
+    case PPC_INST_VSLH:
+        for (size_t i = 0; i < 8; i++)
+            println("\t{0}.u16[{1}] = uint16_t({2}.u16[{1}] << ({3}.u16[{1}] & 0xF));", v(insn.operands[0]), i, v(insn.operands[1]), v(insn.operands[2]));
+        break;
+
+    case PPC_INST_VRLW:
+    case PPC_INST_VRLW128:
+        for (size_t i = 0; i < 4; i++)
+            println("\t{0}.u32[{1}] = __builtin_rotateleft32({2}.u32[{1}], {3}.u32[{1}] & 0x1F);", v(insn.operands[0]), i, v(insn.operands[1]), v(insn.operands[2]));
+        break;
+
+    case PPC_INST_VNOR:
+    case PPC_INST_VNOR128:
+        println("\tsimde_mm_store_si128((simde__m128i*){}.u8, simde_mm_xor_si128(simde_mm_or_si128(simde_mm_load_si128((simde__m128i*){}.u8), simde_mm_load_si128((simde__m128i*){}.u8)), simde_mm_set1_epi32(-1)));", v(insn.operands[0]), v(insn.operands[1]), v(insn.operands[2]));
+        break;
+
     case PPC_INST_VMINFP:
     case PPC_INST_VMINFP128:
         printSetFlushMode(true);
