From e9caa75aff09c09e3a2e50ad36584eaf9f15bb58 Mon Sep 17 00:00:00 2001
From: Kauan Turcato Storto <159664484+KauanDev1@users.noreply.github.com>
Date: Fri, 16 Oct 2026 20:54:14 -0400
Subject: [PATCH 02/10] feat: add load/store-with-update forms lfsu, lfsux,
 stfsu, stfsux, lhzu, sthu

Based on hedge-dev/XenonRecomp PR #60 by Mystixor (MIT).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 XenonRecomp/recompiler.cpp | 44 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 44 insertions(+)

diff --git a/XenonRecomp/recompiler.cpp b/XenonRecomp/recompiler.cpp
index f54a80e..d48299c 100644
--- a/XenonRecomp/recompiler.cpp
+++ b/XenonRecomp/recompiler.cpp
@@ -1235,6 +1235,28 @@ bool Recompiler::Recompile(
         println("{});", int32_t(insn.operands[1]));
         break;
 
+    case PPC_INST_LFSU:
+        printSetFlushMode(false);
+        println("\t{} = {} + {}.u32;", ea(), int32_t(insn.operands[1]), r(insn.operands[2]));
+        println("\t{}.u32 = PPC_LOAD_U32({});", temp(), ea());
+        println("\t{}.f64 = double({}.f32);", f(insn.operands[0]), temp());
+        println("\t{}.u32 = {};", r(insn.operands[2]), ea());
+        break;
+
+    case PPC_INST_LFSUX:
+        printSetFlushMode(false);
+        println("\t{} = {}.u32 + {}.u32;", ea(), r(insn.operands[1]), r(insn.operands[2]));
+        println("\t{}.u32 = PPC_LOAD_U32({});", temp(), ea());
+        println("\t{}.f64 = double({}.f32);", f(insn.operands[0]), temp());
+        println("\t{}.u32 = {};", r(insn.operands[1]), ea());
+        break;
+
+    case PPC_INST_LHZU:
+        println("\t{} = {} + {}.u32;", ea(), int32_t(insn.operands[1]), r(insn.operands[2]));
+        println("\t{}.u64 = PPC_LOAD_U16({});", r(insn.operands[0]), ea());
+        println("\t{}.u32 = {};", r(insn.operands[2]), ea());
+        break;
+
     case PPC_INST_LWZU:
         println("\t{} = {} + {}.u32;", ea(), int32_t(insn.operands[1]), r(insn.operands[2]));
         println("\t{}.u64 = PPC_LOAD_U32({});", r(insn.operands[0]), ea());
@@ -1681,6 +1703,28 @@ bool Recompiler::Recompile(
         println("\t{}.so = {}.so;", cr(0), xer());
         break;
 
+    case PPC_INST_STFSU:
+        printSetFlushMode(false);
+        println("\t{} = {} + {}.u32;", ea(), int32_t(insn.operands[1]), r(insn.operands[2]));
+        println("\t{}.f32 = float({}.f64);", temp(), f(insn.operands[0]));
+        println("{}{}, {}.u32);", mmioStore() ? "\tPPC_MM_STORE_U32(" : "\tPPC_STORE_U32(", ea(), temp());
+        println("\t{}.u32 = {};", r(insn.operands[2]), ea());
+        break;
+
+    case PPC_INST_STFSUX:
+        printSetFlushMode(false);
+        println("\t{} = {}.u32 + {}.u32;", ea(), r(insn.operands[1]), r(insn.operands[2]));
+        println("\t{}.f32 = float({}.f64);", temp(), f(insn.operands[0]));
+        println("{}{}, {}.u32);", mmioStore() ? "\tPPC_MM_STORE_U32(" : "\tPPC_STORE_U32(", ea(), temp());
+        println("\t{}.u32 = {};", r(insn.operands[1]), ea());
+        break;
+
+    case PPC_INST_STHU:
+        println("\t{} = {} + {}.u32;", ea(), int32_t(insn.operands[1]), r(insn.operands[2]));
+        println("{}{}, {}.u16);", mmioStore() ? "\tPPC_MM_STORE_U16(" : "\tPPC_STORE_U16(", ea(), r(insn.operands[0]));
+        println("\t{}.u32 = {};", r(insn.operands[2]), ea());
+        break;
+
     case PPC_INST_STWU:
         println("\t{} = {} + {}.u32;", ea(), int32_t(insn.operands[1]), r(insn.operands[2]));
         println("\tPPC_STORE_U32({}, {}.u32);", ea(), r(insn.operands[0]));
