From c88a374ec4a4c942a07c85c61f5b165c67212571 Mon Sep 17 00:00:00 2001
From: Kauan Turcato Storto <159664484+KauanDev1@users.noreply.github.com>
Date: Sun, 18 Oct 2026 19:53:17 -0400
Subject: [PATCH 04/10] feat: add addc, addme and mulhd

addc/addc. and addme/addme. set CA from the 32-bit carry out (computed
before rD is written, as rD may alias a source); mulhd takes the high
doubleword of the signed 128-bit product. The Rc forms compare as the
other integer instructions do.

Based on hedge-dev/XenonRecomp PR #60 by Mystixor (MIT); mulhd uses a
128-bit product instead of the PR's 64-bit one.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 XenonRecomp/recompiler.cpp | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/XenonRecomp/recompiler.cpp b/XenonRecomp/recompiler.cpp
index 3d28f89..5dc7e5a 100644
--- a/XenonRecomp/recompiler.cpp
+++ b/XenonRecomp/recompiler.cpp
@@ -537,6 +537,23 @@ bool Recompiler::Recompile(
             println("\t{}.compare<int32_t>({}.s32, 0, {});", cr(0), r(insn.operands[0]), xer());
         break;
 
+    case PPC_INST_ADDC:
+        // CA is the 32-bit carry out; computed before rD is written, as rD may alias rA or rB.
+        println("\t{}.ca = {}.u32 > ~{}.u32;", xer(), r(insn.operands[2]), r(insn.operands[1]));
+        println("\t{}.u64 = {}.u64 + {}.u64;", r(insn.operands[0]), r(insn.operands[1]), r(insn.operands[2]));
+        if (strchr(insn.opcode->name, '.'))
+            println("\t{}.compare<int32_t>({}.s32, 0, {});", cr(0), r(insn.operands[0]), xer());
+        break;
+
+    case PPC_INST_ADDME:
+        // rD = rA + CA - 1, i.e. rA + CA + 0xFFFFFFFF in 32 bits: CA is that sum's carry out.
+        println("\t{}.u64 = uint64_t({}.u32) + {}.ca + 0xFFFFFFFFull;", temp(), r(insn.operands[1]), xer());
+        println("\t{}.u64 = {}.u64 + {}.ca - 1;", r(insn.operands[0]), r(insn.operands[1]), xer());
+        println("\t{}.ca = {}.u64 >> 32;", xer(), temp());
+        if (strchr(insn.opcode->name, '.'))
+            println("\t{}.compare<int32_t>({}.s32, 0, {});", cr(0), r(insn.operands[0]), xer());
+        break;
+
     case PPC_INST_ADDE:
         println("\t{}.u8 = ({}.u32 + {}.u32 < {}.u32) | ({}.u32 + {}.u32 + {}.ca < {}.ca);", temp(), r(insn.operands[1]), r(insn.operands[2]), r(insn.operands[1]), r(insn.operands[1]), r(insn.operands[2]), xer(), xer());
         println("\t{}.u64 = {}.u64 + {}.u64 + {}.ca;", r(insn.operands[0]), r(insn.operands[1]), r(insn.operands[2]), xer());
@@ -1339,6 +1356,12 @@ bool Recompiler::Recompile(
         println("\t{}.ca = ({}.u64 & 0x20000000) != 0;", xer(), r(insn.operands[0]));
         break;
 
+    case PPC_INST_MULHD:
+        println("\t{}.s64 = int64_t((__int128({}.s64) * __int128({}.s64)) >> 64);", r(insn.operands[0]), r(insn.operands[1]), r(insn.operands[2]));
+        if (strchr(insn.opcode->name, '.'))
+            println("\t{}.compare<int64_t>({}.s64, 0, {});", cr(0), r(insn.operands[0]), xer());
+        break;
+
     case PPC_INST_MULHW:
         println("\t{}.s64 = (int64_t({}.s32) * int64_t({}.s32)) >> 32;", r(insn.operands[0]), r(insn.operands[1]), r(insn.operands[2]));
         break;
