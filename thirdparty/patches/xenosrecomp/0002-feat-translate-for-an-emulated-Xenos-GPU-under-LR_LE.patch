 void ShaderRecompiler::recompile(const uint8_t* shaderData, const std::string_view& include)
 {
     const auto shaderContainer = reinterpret_cast<const ShaderContainer*>(shaderData);
 
+#ifndef LR_LEGACYRECOMP
     assert((shaderContainer->flags & 0xFFFFFF00) == 0x102A1100);
     assert(shaderContainer->constantTableOffset != NULL);
+#else
+    // Every table the translation reads must lie inside the container (containerSize bytes from shaderData).
+    auto inRange = [&](size_t offset, size_t size)
+        {
+            return offset <= containerSize && size <= containerSize - offset;
+        };
+
+    LR_CHECK(containerSize >= sizeof(ShaderContainer), "container is smaller than its header");
+    LR_CHECK((shaderContainer->flags & 0xFFFFFF00) == 0x102A1100, "not a shader container");
+    const size_t lrVirtualSize = shaderContainer->virtualSize;
+    LR_CHECK(lrVirtualSize <= containerSize, "virtual size {} exceeds the container ({} bytes)", lrVirtualSize, containerSize);
+
+    const size_t lrConstantTableOffset = shaderContainer->constantTableOffset;
+    LR_CHECK(lrConstantTableOffset != 0 && inRange(lrConstantTableOffset, sizeof(ConstantTableContainer)),
+        "constant table at {} is outside the container", lrConstantTableOffset);
+    {
+        const auto table = reinterpret_cast<const ConstantTableContainer*>(shaderData + lrConstantTableOffset);
+        const size_t tableStart = lrConstantTableOffset + offsetof(ConstantTableContainer, constantTable);
+        const size_t infoStart = tableStart + table->constantTable.constantInfo;
+        LR_CHECK(inRange(infoStart, size_t(table->constantTable.constants) * sizeof(ConstantInfo)),
+            "constant infos are outside the container");
+        for (uint32_t i = 0; i < table->constantTable.constants; i++)
+        {
+            const auto info = reinterpret_cast<const ConstantInfo*>(shaderData + infoStart + i * sizeof(ConstantInfo));
+            const size_t name = tableStart + info->name;
+            LR_CHECK(inRange(name, 1) && memchr(shaderData + name, 0, containerSize - name) != nullptr,
+                "constant {} has its name outside the container", i);
+        }
+    }
+
+    const size_t lrShaderOffset = shaderContainer->shaderOffset;
+    const bool lrIsPixelShader = (shaderContainer->flags & 0x1) == 0;
+    LR_CHECK(inRange(lrShaderOffset, lrIsPixelShader ? sizeof(PixelShader) : sizeof(VertexShader)),
+        "shader header at {} is outside the container", lrShaderOffset);
+    {
+        const auto lrShader = reinterpret_cast<const Shader*>(shaderData + lrShaderOffset);
+        const size_t interpolatorCount = (lrShader->interpolatorInfo >> 5) & 0x1F;
+        if (lrIsPixelShader)
+        {
+            LR_CHECK(inRange(lrShaderOffset + sizeof(PixelShader), interpolatorCount * 4),
+                "pixel shader interpolators are outside the container");
+        }
+        else
+        {
+            const auto vs = reinterpret_cast<const VertexShader*>(lrShader);
+            LR_CHECK(inRange(lrShaderOffset + sizeof(VertexShader),
+                (size_t(vs->field18) + vs->vertexElementCount + interpolatorCount) * 4),
+                "vertex elements and interpolators are outside the container");
+        }
+
+        const size_t microcodeOffset = lrVirtualSize + lrShader->physicalOffset;
+        LR_CHECK(inRange(microcodeOffset, lrShader->size), "microcode ({} bytes at {}) is outside the container",
+            uint32_t(lrShader->size), microcodeOffset);
+        LR_CHECK(lrShader->size != 0 && lrShader->size % 12 == 0, "microcode size {} is not a whole number of instructions",
+            uint32_t(lrShader->size));
+        microcodeHash = XXH3_64bits(shaderData + microcodeOffset, lrShader->size);
+    }
+#endif
 
