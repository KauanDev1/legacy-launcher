+
+// The exec-type control flow clauses of a microcode block, in control flow order (the same walk as the translator:
+// control flow pairs up to the first instruction address).
+static std::vector<LrExecClause> lrCollectExecClauses(const be<uint32_t>* code, uint32_t size)
+{
+    std::vector<LrExecClause> clauses;
+    uint32_t instrSize = size;
+    for (uint32_t instrAddress = 0; instrAddress < instrSize; instrAddress += 12, code += 3)
+    {
+        union
+        {
+            ControlFlowInstruction controlFlow[2];
+            struct
+            {
+                uint32_t code0;
+                uint32_t code1;
+                uint32_t code2;
+                uint32_t code3;
+            };
+        };
+
+        code0 = code[0];
+        code1 = code[1] & 0xFFFF;
+        code2 = (code[1] >> 16) | (code[2] << 16);
+        code3 = code[2] >> 16;
+
+        for (auto& cfInstr : controlFlow)
+        {
+            switch (cfInstr.opcode)
+            {
+            case ControlFlowOpcode::Exec:
+            case ControlFlowOpcode::ExecEnd:
+            case ControlFlowOpcode::CondExec:
+            case ControlFlowOpcode::CondExecEnd:
+            case ControlFlowOpcode::CondExecPred:
+            case ControlFlowOpcode::CondExecPredEnd:
+            case ControlFlowOpcode::CondExecPredClean:
+            case ControlFlowOpcode::CondExecPredCleanEnd:
+                // The exec layouts share address, count and sequence.
+                clauses.push_back({ cfInstr.exec.address, cfInstr.exec.count, cfInstr.exec.sequence });
+                if (cfInstr.exec.address != 0)
+                    instrSize = std::min<uint32_t>(instrSize, cfInstr.exec.address * 12);
+                break;
+            }
+        }
+    }
+    return clauses;
+}
+#endif
