From 2e14c72c327ee179414ef1e3083de1d7a48b4d94 Mon Sep 17 00:00:00 2001
From: Kauan Turcato Storto <159664484+KauanDev1@users.noreply.github.com>
Date: Thu, 22 Oct 2026 12:42:17 -0400
Subject: [PATCH 1/4] build: LR_LEGACYRECOMP passes its define to DXC and keeps
 DXC diagnostics

LegacyRecomp (an emulated Xenos GPU on Vulkan) builds XenosRecomp with
LR_LEGACYRECOMP. In that mode the HLSL is compiled with -DLR_LEGACYRECOMP
(shader_common.h selects the LegacyRecomp contract with it), and DXC errors
are kept in DxcCompiler::lastErrors so the tool can report them per shader
instead of printing them unattributed from parallel workers.

LegacyRecomp patch; same license as XenosRecomp (MIT).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 XenosRecomp/dxc_compiler.cpp | 9 +++++++++
 XenosRecomp/dxc_compiler.h   | 3 +++
 2 files changed, 12 insertions(+)

diff --git a/XenosRecomp/dxc_compiler.cpp b/XenosRecomp/dxc_compiler.cpp
index fcbc43a..2b56f08 100644
--- a/XenosRecomp/dxc_compiler.cpp
+++ b/XenosRecomp/dxc_compiler.cpp
@@ -58,6 +58,11 @@ IDxcBlob* DxcCompiler::compile(const std::string& shaderSource, bool compilePixe
     args[argCount++] = L"-DUNLEASHED_RECOMP";
 #endif
 
+#ifdef LR_LEGACYRECOMP
+    args[argCount++] = L"-DLR_LEGACYRECOMP";
+    lastErrors.clear();
+#endif
+
     IDxcResult* result = nullptr;
     HRESULT hr = dxcCompiler->Compile(&source, args, argCount, nullptr, IID_PPV_ARGS(&result));
 
@@ -78,7 +83,11 @@ IDxcBlob* DxcCompiler::compile(const std::string& shaderSource, bool compilePixe
                 hr = result->GetOutput(DXC_OUT_ERRORS, IID_PPV_ARGS(&errors), nullptr);
                 assert(SUCCEEDED(hr) && errors != nullptr);
 
+            #ifdef LR_LEGACYRECOMP
+                lastErrors = errors->GetStringPointer();
+            #else
                 fputs(errors->GetStringPointer(), stderr);
+            #endif
 
                 errors->Release();
             }
diff --git a/XenosRecomp/dxc_compiler.h b/XenosRecomp/dxc_compiler.h
index d49bd32..ec09ccd 100644
--- a/XenosRecomp/dxc_compiler.h
+++ b/XenosRecomp/dxc_compiler.h
@@ -3,6 +3,9 @@
 struct DxcCompiler
 {
     IDxcCompiler3* dxcCompiler = nullptr;
+#ifdef LR_LEGACYRECOMP
+    std::string lastErrors; // DXC diagnostics of the last failed compile
+#endif
 
     DxcCompiler();
     ~DxcCompiler();
