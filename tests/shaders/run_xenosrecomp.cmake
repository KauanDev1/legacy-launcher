# SPDX-License-Identifier: MIT
# Runs the patched XenosRecomp (LegacyRecomp mode) on a directory of synthetic shader containers.
# EXPECT=success: the tool must exit 0 and print "translated N of N"; its output goes to LOG.
# EXPECT=failure: the tool must exit non-zero and print EXPECT_TEXT (e.g. "translated 0 of 1").
# Usage: cmake -DTOOL=<exe> -DINCLUDE=<shader_common.h> -DIN=<dir> -DOUT=<shader_cache.cpp> [-DHLSL=<dir>]
#              [-DLOG=<file>] -DEXPECT=success|failure [-DEXPECT_TEXT=<text>] -P run_xenosrecomp.cmake
set(_args "${IN}" "${OUT}" "${INCLUDE}")
if(HLSL)
  file(REMOVE_RECURSE "${HLSL}")
  list(APPEND _args --hlsl-dir "${HLSL}")
endif()
file(REMOVE "${OUT}")
execute_process(COMMAND "${TOOL}" ${_args} RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
set(_all "${_out}${_err}")
if(LOG)
  file(WRITE "${LOG}" "${_all}")
endif()
message(STATUS "${_all}")
if(EXPECT STREQUAL "success")
  if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "XenosRecomp exited with ${_rc}")
  endif()
  if(NOT _out MATCHES "translated ([0-9]+) of ([0-9]+)")
    message(FATAL_ERROR "XenosRecomp did not print 'translated N of M'")
  endif()
  if(NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2 OR CMAKE_MATCH_1 EQUAL 0)
    message(FATAL_ERROR "XenosRecomp translated ${CMAKE_MATCH_1} of ${CMAKE_MATCH_2}")
  endif()
  if(NOT EXISTS "${OUT}")
    message(FATAL_ERROR "XenosRecomp did not write ${OUT}")
  endif()
else()
  if(_rc EQUAL 0)
    message(FATAL_ERROR "XenosRecomp exited 0 on a broken container")
  endif()
  string(FIND "${_all}" "${EXPECT_TEXT}" _pos)
  if(_pos EQUAL -1)
    message(FATAL_ERROR "XenosRecomp output lacks '${EXPECT_TEXT}'")
  endif()
endif()
